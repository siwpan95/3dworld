{
  "state_machines": {
    "SM_Director": {
      "initial": "teleport",
      "description": "kkrieger 第六幕导演（118–150s，时间驱动转移）",
      "states": {
        "teleport": {
          "content": "白闪传送落地",
          "on_enter": "落点 (0,4.2,-79.5) 面向反应堆",
          "transitions": {"at_121_5": "descend"}
        },
        "descend": {
          "content": "下降逼近反应堆",
          "on_enter": "降到 y=4.5 中线",
          "transitions": {"at_125": "orbit"}
        },
        "orbit": {
          "content": "环绕环面结（右弧 → 俯瞰 → 左弧）",
          "on_enter": "半径 ~7 环绕",
          "transitions": {"at_136_5": "dive"}
        },
        "dive": {
          "content": "俯冲低弧（点火前兆）",
          "on_enter": "压低到 y=4.4",
          "transitions": {"at_140_8": "face_off"}
        },
        "face_off": {
          "content": "贴脸驻留（141.5s 点火 · 二次白闪）",
          "on_enter": "机位 (0,5.0,-86.3) 距核心 ~3.2m",
          "transitions": {"at_141_8": "return"}
        },
        "return": {
          "content": "白闪传送回场 + 缓慢沉降",
          "on_enter": "回开场高空帧 (0,9,12)",
          "transitions": {}
        }
      }
    }
  },
  "markov_chains": {
    "MC_Embers": {
      "name": "圣殿反应堆余烬的随机闪烁模式",
      "states": ["dim", "glow", "spark", "flare"],
      "matrix": {
        "dim":   {"dim": 0.55, "glow": 0.40, "spark": 0.05, "flare": 0.00},
        "glow":  {"dim": 0.35, "glow": 0.40, "spark": 0.20, "flare": 0.05},
        "spark": {"dim": 0.20, "glow": 0.35, "spark": 0.30, "flare": 0.15},
        "flare": {"dim": 0.45, "glow": 0.30, "spark": 0.20, "flare": 0.05}
      },
      "initial": "dim"
    }
  },
  "orchestration": {
    "kkrieger_act6": {
      "description": "导演状态机每进入新阶段 → 级联推进余烬马尔可夫链一次（演出随机变体来源）",
      "engines": {
        "sm": {"kind": "state_machine", "name": "SM_Director"},
        "mc": {"kind": "markov_chain", "name": "MC_Embers"}
      },
      "bindings": [
        {
          "when": {"engine": "sm", "etype": "enter"},
          "then": {"engine": "mc", "action": "step"}
        }
      ],
      "start": [
        {"engine": "sm", "action": "step", "ctx": {"event": "at_121_5"}}
      ]
    }
  }
}
